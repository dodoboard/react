{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "flux1-dev-fp8.safetensors"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["1", 1]}},
  "3": {"class_type": "FluxGuidance", "inputs": {"guidance": 2.6, "conditioning": ["2", 0]}, "_meta": {"title": "lower guidance = less 'AI gloss'"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
  "5": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "6": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "beta", "denoise": 1.0, "model": ["1", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["5", 0]}},
  "7": {"class_type": "LatentUpscaleBy", "inputs": {"upscale_method": "bislerp", "scale_by": 1.5, "samples": ["6", 0]}},
  "8": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": 12, "cfg": 1.0, "sampler_name": "euler", "scheduler": "beta", "denoise": 0.35, "model": ["1", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["7", 0]}, "_meta": {"title": "hires fix: skin pores, fabric, stone detail"}},
  "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["1", 2]}},
  "10": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": "{{upscale_model}}"}},
  "11": {"class_type": "ImageUpscaleWithModel", "inputs": {"upscale_model": ["10", 0], "image": ["9", 0]}},
  "12": {"class_type": "ImageScale", "inputs": {"upscale_method": "lanczos", "width": "{{out_width}}", "height": "{{out_height}}", "crop": "disabled", "image": ["11", 0]}},
  "13": {"class_type": "SaveImage", "inputs": {"filename_prefix": "{{filename_prefix}}", "images": ["12", 0]}}
}
