{
  "_requires": "ComfyUI-PuLID-Flux custom nodes + insightface + EVA-CLIP",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "flux1-dev-fp8.safetensors"}},
  "2": {"class_type": "PulidFluxModelLoader", "inputs": {"pulid_file": "pulid_flux_v0.9.1.safetensors"}},
  "3": {"class_type": "PulidFluxEvaClipLoader", "inputs": {}},
  "4": {"class_type": "PulidFluxInsightFaceLoader", "inputs": {"provider": "CUDA"}},
  "5": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}},
  "6": {"class_type": "ApplyPulidFlux", "inputs": {"model": ["1", 0], "pulid_flux": ["2", 0], "eva_clip": ["3", 0], "face_analysis": ["4", 0], "image": ["5", 0], "weight": 0.9, "start_at": 0.0, "end_at": 1.0}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["1", 1]}},
  "8": {"class_type": "FluxGuidance", "inputs": {"guidance": 3.0, "conditioning": ["7", 0]}},
  "9": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
  "10": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "11": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0, "model": ["6", 0], "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["10", 0]}},
  "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["1", 2]}},
  "13": {"class_type": "SaveImage", "inputs": {"filename_prefix": "{{filename_prefix}}", "images": ["12", 0]}}
}
